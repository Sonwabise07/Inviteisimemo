# Flask core
SECRET_KEY=replace-with-a-random-secret-key

# Database
# Leave blank for local SQLite. Use PostgreSQL in production.
DATABASE_URL=

# Email
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
CONTACT_EMAIL=inviteisimemo@gmail.com

# Admin
FIRST_ADMIN_EMAIL=
ADMIN_TOKEN=

# Security / runtime
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URL=memory://
ARCHIVE_AFTER_DAYS=365

# Object storage for production uploads (Cloudflare R2, Backblaze B2, AWS S3)
# Leave blank locally to use static/uploads.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
S3_PUBLIC_URL=

# PayFast payments (get credentials from payfast.co.za → Dashboard → Integration)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
SUBSCRIPTION_PRICE_ZAR=99

# Your app's public URL (used to build PayFast notify/return URLs)
# Example: https://your-app.onrender.com
APP_BASE_URL=
