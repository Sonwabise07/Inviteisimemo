# Flask core
SECRET_KEY=replace-with-a-random-secret-key

# Database
# Leave blank for local SQLite. Use PostgreSQL in production.
DATABASE_URL=

# Email
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true

# Admin
FIRST_ADMIN_EMAIL=
ADMIN_TOKEN=

# Security / runtime
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URL=memory://
ARCHIVE_AFTER_DAYS=365
